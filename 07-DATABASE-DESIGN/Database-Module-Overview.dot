 Operations [label="R0–R2 · OPERATIONS\nOutbox • Notifications • Audit • Safety", fillcolor="#f3f5f8"];
 {rank=same; Identity; Catalogue}
 {rank=same; Marketplace; Media; Commerce}
 {rank=same; XContent; XAssess; XAssign}
 Identity -> Marketplace; Catalogue -> Marketplace; Marketplace -> Commerce;
 Catalogue -> XContent; XContent -> XAssess; XContent -> XAssign;
 XAssign -> XAssess; Media -> Marketplace [dir=back]; Media -> XContent [dir=back];
 Identity -> Operations [style=dashed]; Commerce -> Operations [style=dashed]; XAssess -> Operations [style=dashed];
}
